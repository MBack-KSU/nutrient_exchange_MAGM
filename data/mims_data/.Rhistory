library(mimsy)
data_2023_2 <- read.csv("C:\\Users\\mikeb\\Documents\\Kinsman-Costello Lab\\Dissertation\\MAGM nutrient flux manuscript\\data\\mims_data\\data_mimsy_2023_2.csv",
header = TRUE, stringsAsFactors = FALSE)
str(data_2023_2)
View(data_2023_2)
results_2023_2 <- mimsy(data_2023_2, baromet.press = 1.00, units = 'atm') #couldn't find barometric pressure for 10/27/2022, so I used barometric pressure of Kent Ohio on 7/22/2024 via the barometric pressure app (apple) of 30.03 inHg converted to atm
results_2023_2
mimsy.save(results_2023_2, "C:\\Users\\mikeb\\Documents\\Kinsman-Costello Lab\\Dissertation\\MAGM nutrient flux manuscript\\data\\mims_data\\mimsyCalcs_2023_2.xlsx")
